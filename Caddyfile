{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/internal/tls/authorize
	}
}

:80 {
	route {
		@tls_authorization path /api/internal/tls/authorize
		respond @tls_authorization 404
		redir https://{host}{uri} 308
	}
}

:443 {
	tls {
		on_demand
	}
	route {
		# The certificate authorization endpoint is only for Caddy's private Docker-network request.
		@tls_authorization path /api/internal/tls/authorize
		respond @tls_authorization 404
		reverse_proxy app:3000 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
