  reviewer  Staff?     @relation("PinTransferReviewer", fields: [reviewedById], references: [id])
  resultPin ResultPIN? @relation(fields: [resultPinId], references: [id], onDelete: SetNull)
  generatedPin GeneratedPin? @relation(fields: [generatedPinId], references: [id], onDelete: SetNull)

  @@unique([tenantId, transactionRef])
  @@index([tenantId, status])
  @@index([studentId, termId])
  @@map("pin_transfer_verifications")
}

model StaffAttendance {
  id           String                @id @default(cuid())
  tenantId     String                @map("tenant_id")
  staffId      String                @map("staff_id")
  date         DateTime              @db.Date
  clockInTime  DateTime?             @map("clock_in_time")
  clockOutTime DateTime?             @map("clock_out_time")
  status       StaffAttendanceStatus @default(present)
  minutesLate  Int                   @default(0) @map("minutes_late")
  method       String                @default("kiosk") @map("method")
  markedBy     String?               @map("marked_by")
  notes        String?
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([tenantId, date])
  @@index([tenantId, staffId])
  @@map("staff_attendances")
}

model StaffLeaveRequest {
  id         String             @id @default(cuid())
  tenantId   String             @map("tenant_id")
  staffId    String             @map("staff_id")
  leaveType  String             @map("leave_type")
  startDate  DateTime           @map("start_date") @db.Date
  endDate    DateTime           @map("end_date") @db.Date
  reason     String
  status     LeaveRequestStatus @default(pending)
  reviewedBy String?            @map("reviewed_by")
  reviewedAt DateTime?          @map("reviewed_at")
  adminNotes String?            @map("admin_notes")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffId])
  @@map("staff_leave_requests")
}

model TimetablePeriod {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  name       String
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  orderIndex Int      @map("order_index")
  isBreak    Boolean  @default(false) @map("is_break")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slots  TimetableSlot[]

  @@unique([tenantId, orderIndex])
  @@map("timetable_periods")
}

model TimetableSlot {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  sessionId    String?  @map("session_id")
  classLevelId String   @map("class_level_id")
  dayOfWeek    Int      @map("day_of_week")
  periodId     String   @map("period_id")
  subjectId    String?  @map("subject_id")
  staffId      String?  @map("staff_id")
  room         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session    AcademicSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classLevel ClassLevel       @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  period     TimetablePeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subject    Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  staff      Staff?           @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@unique([classLevelId, dayOfWeek, periodId])
  @@index([tenantId, classLevelId])
  @@index([tenantId, staffId, dayOfWeek, periodId])
  @@map("timetable_slots")
}
