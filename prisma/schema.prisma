datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum TenantStatus {
  trial
  active
  suspended
  cancelled
  archived
}

enum EnrollmentStatus {
  active
  repeated
  graduated
  withdrawn
}

enum StaffRole {
  teacher
  admin
}

enum ResultStatus {
  not_started
  submitted
  form_teacher_reviewed
  published
}

enum AttendanceStatus {
  present
  absent
  late
}

enum StaffAttendanceStatus {
  present
  late
  absent
  excused
  half_day
}

enum LeaveRequestStatus {
  pending
  approved
  rejected
}

enum PinStatus {
  unused
  active
  expired
}

enum FeePaymentMethod {
  gateway
  cash
  bank_transfer
}

enum PaymentVerificationStatus {
  pending
  approved
  rejected
}

enum FeeAdjustmentType {
  discount
  waiver
}

enum NotificationRecipientType {
  school_admin
  staff
  parent
  student
  super_admin
}

enum JobStatus {
  queued
  processing
  completed
  failed
}

enum JobType {
  bulk_report_cards
  bulk_sms_dispatch
  bulk_whatsapp_dispatch
  data_export
  notification_delivery
}

enum BackupTrigger {
  manual
  automated_scheduled
  pre_promotion
  pre_migration
}

enum BackupStatus {
  pending
  completed
  failed
  restored
}

model SuperAdmin {
  id             String              @id @default(cuid())
  email          String              @unique
  name           String
  passwordHash   String              @map("password_hash")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  impersonations ImpersonationLog[]
  sessions       SuperAdminSession[]
  passwordResetTokens SuperAdminPasswordResetToken[]

  @@map("super_admins")
}

model Plan {
  id                 String        @id @default(cuid())
  name               String        @unique
  studentCeiling     Int           @map("student_ceiling")
  price              Decimal       @default(0.00) @db.Decimal(10, 2)
  pinRequired        Boolean       @default(true) @map("pin_required")
  platformFeePercent Decimal       @default(10.00) @map("platform_fee_percent") @db.Decimal(5, 2)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  tenants            Tenant[]
  features           PlanFeature[]

  @@map("plans")
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model Feature {
  id           String                  @id @default(cuid())
  key          String                  @unique
  name         String
  description  String?
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  planDefaults PlanFeature[]
  overrides    TenantFeatureOverride[]

  @@map("features")
}

model PlanFeature {
  planId           String  @map("plan_id")
  featureKey       String  @map("feature_key")
  enabledByDefault Boolean @default(true) @map("enabled_by_default")
  plan             Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature          Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@id([planId, featureKey])
  @@map("plan_features")
}

model TenantFeatureOverride {
  tenantId   String  @map("tenant_id")
  featureKey String  @map("feature_key")
  enabled    Boolean @default(true)
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature    Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@id([tenantId, featureKey])
  @@map("tenant_feature_overrides")
}

model Tenant {
  id                         String       @id @default(cuid())
  slug                       String       @unique
  name                       String
  planId                     String       @map("plan_id")
  status                     TenantStatus @default(trial)
  trialEndsAt                DateTime?    @map("trial_ends_at")
  lowestClassLevelId         String?      @map("lowest_class_level_id")
  highestClassLevelId        String?      @map("highest_class_level_id")
  branding                   Json         @default("{\"primaryColor\":\"#0F172A\",\"accentColor\":\"#2563EB\",\"logoUrl\":null,\"fontHeading\":\"Inter\",\"fontBody\":\"Inter\"}")
  pinPrice                   Decimal      @default(1000.00) @map("pin_price") @db.Decimal(10, 2)
  annualContractPrice        Decimal?     @map("annual_contract_price") @db.Decimal(10, 2)
  subscriptionStartedAt      DateTime?    @map("subscription_started_at")
  subscriptionExpiresAt      DateTime?    @map("subscription_expires_at")
  blockPromotionOnFeeBalance Boolean      @default(false) @map("block_promotion_on_fee_balance")
  bankName                   String?      @map("bank_name")
  bankAccountNumber          String?      @map("bank_account_number")
  bankAccountName            String?      @map("bank_account_name")
  hasOnlinePayment           Boolean      @default(true) @map("has_online_payment")
  hasOnlinePinPayment        Boolean      @default(false) @map("has_online_pin_payment")
  blockResultOnFeeBalance    Boolean      @default(true) @map("block_result_on_fee_balance")
  workStartTime              String?      @default("07:30") @map("work_start_time")
  lateThresholdTime          String?      @default("07:45") @map("late_threshold_time")
  workEndTime                String?      @default("15:30") @map("work_end_time")
  campusLatitude             Float?       @map("campus_latitude")
  campusLongitude            Float?       @map("campus_longitude")
  campusRadiusMeters         Int?         @default(200) @map("campus_radius_meters")
  enableGeofenceAttendance   Boolean      @default(false) @map("enable_geofence_attendance")
  admissionNumberPrefix      String?      @map("admission_number_prefix")
  archivedAt                 DateTime?    @map("archived_at")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  plan                    Plan                     @relation(fields: [planId], references: [id])
  lowestClassLevel        ClassLevel?              @relation("TenantLowestClass", fields: [lowestClassLevelId], references: [id])
  highestClassLevel       ClassLevel?              @relation("TenantHighestClass", fields: [highestClassLevelId], references: [id])
  domainAliases           DomainAlias[]
  admissionNumberCounters AdmissionNumberCounter[]
  featureOverrides        TenantFeatureOverride[]
  impersonationLogs       ImpersonationLog[]
  sessions                AcademicSession[]
  students                Student[]
  staff                   Staff[]
  subjects                Subject[]
  feeItems                FeeItem[]
  siteContents            SiteContent[]
  galleryImages           GalleryImage[]
  notifications           Notification[]
  users                   TenantUser[]
  authSessions            TenantSession[]
  assessmentComponents    AssessmentComponent[]
  gradingScales           GradingScale[]
  resultAuditLogs         ResultAuditLog[]
  auditLogs               AuditLog[]
  smsConfiguration        SmsConfiguration?
  smsLogs                 SmsLog[]
  whatsAppLogs            WhatsAppLog[]
  cbtExams                CbtExam[]
  transportVehicles       TransportVehicle[]
  transportRoutes         TransportRoute[]
  pinBatches              PinBatch[]
  generatedPins           GeneratedPin[]
  backgroundJobs          BackgroundJob[]
  backups                 TenantBackup[]
  emailConfiguration      EmailConfiguration?
  conversations           Conversation[]
  messages                Message[]
  guardians               Guardian[]
  feePaymentVerifications FeePaymentVerification[]
  pinTransferVerifications PinTransferVerification[]
  staffAttendances        StaffAttendance[]
  staffLeaveRequests      StaffLeaveRequest[]
  timetablePeriods        TimetablePeriod[]
  timetableSlots          TimetableSlot[]
  reportCardAssessments   ReportCardAssessment[]
  paymentGateway          TenantPaymentGateway?
  paymentIntents          PaymentIntent[]
  pinSettlements          PinSettlement[]

  @@map("tenants")
}

model DomainAlias {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  domain            String    @unique
  verifiedAt        DateTime? @map("verified_at")
  verificationToken String    @map("verification_token")
  createdAt         DateTime  @default(now()) @map("created_at")
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("domain_aliases")
}

model ClassLevel {
  id                     String                  @id @default(cuid())
  name                   String                  @unique
  orderIndex             Int                     @unique @map("order_index")
  tenantsLowest          Tenant[]                @relation("TenantLowestClass")
  tenantsHighest         Tenant[]                @relation("TenantHighestClass")
  enrollments            Enrollment[]
  teachingAssignments    TeachingAssignment[]
  formTeacherAssignments FormTeacherAssignment[]
  reviews                ClassResultReview[]
  reportCardAssessments  ReportCardAssessment[]
  feeItems               FeeItem[]
  gradingScalesLowest    GradingScale[]          @relation("GradingScaleLowest")
  gradingScalesHighest   GradingScale[]          @relation("GradingScaleHighest")
  cbtExams               CbtExam[]
  timetableSlots         TimetableSlot[]

  @@map("class_levels")
}

model AcademicSession {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  label     String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms                  Term[]
  enrollments            Enrollment[]
  teachingAssignments    TeachingAssignment[]
  formTeacherAssignments FormTeacherAssignment[]
  timetableSlots         TimetableSlot[]

  @@unique([tenantId, label])
  @@map("academic_sessions")
}

model Term {
  id              String   @id @default(cuid())
  sessionId       String   @map("session_id")
  name            String
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  isCurrent       Boolean  @default(false) @map("is_current")
  totalSchoolDays Int?     @map("total_school_days")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  session                 AcademicSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  resultEntries           ResultEntry[]
  reviews                 ClassResultReview[]
  pins                    ResultPIN[]
  feeItems                FeeItem[]
  feePayments             FeePayment[]
  assessmentComponents    AssessmentComponent[]
  attendanceRecords       AttendanceRecord[]
  cbtExams                CbtExam[]
  feePaymentVerifications FeePaymentVerification[]
  pinTransferVerifications PinTransferVerification[]
  generatedPins           GeneratedPin[]
  reportCardAssessments   ReportCardAssessment[]

  @@unique([sessionId, name])
  @@map("terms")
}

model Student {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  admissionNumber     String?  @map("admission_number")
  name                String
  guardianContactInfo Json?    @map("guardian_contact_info")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments             Enrollment[]
  resultEntries           ResultEntry[]
  pins                    ResultPIN[]
  resultPinUsages         ResultPinUsage[]
  feeAdjustments          StudentFeeAdjustment[]
  feePayments             FeePayment[]
  attendanceRecords       AttendanceRecord[]
  userAccount             TenantUser?
  cbtAttempts             CbtStudentAttempt[]
  busSubscriptions        StudentBusSubscription[]
  guardians               StudentGuardian[]
  feePaymentVerifications FeePaymentVerification[]
  pinTransferVerifications PinTransferVerification[]
  generatedPins           GeneratedPin[]
  reportCardAssessments   ReportCardAssessment[]

  @@unique([tenantId, admissionNumber])
  @@map("students")
}

model Enrollment {
  id           String           @id @default(cuid())
  studentId    String           @map("student_id")
  classLevelId String           @map("class_level_id")
  sessionId    String           @map("session_id")
  status       EnrollmentStatus @default(active)
  createdAt    DateTime         @default(now()) @map("created_at")

  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classLevel ClassLevel      @relation(fields: [classLevelId], references: [id])
  session    AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId])
  @@map("enrollments")
}

model Staff {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  name        String
  roleBase    StaffRole @default(teacher) @map("role_base")
  contactInfo Json?     @map("contact_info")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teachingAssignments    TeachingAssignment[]
  formTeacherAssignments FormTeacherAssignment[]
  resultEntries          ResultEntry[]
  classReviews           ClassResultReview[]
  recordedPayments       FeePayment[]
  markedAttendances      AttendanceRecord[]       @relation("AttendanceMarker")
  reviewedVerifications  FeePaymentVerification[] @relation("VerificationReviewer")
  reviewedPinTransfers   PinTransferVerification[] @relation("PinTransferReviewer")
  userAccount            TenantUser?
  staffCode              String?                  @map("staff_code")
  attendancePin          String?                  @default("1234") @map("attendance_pin")
  attendances            StaffAttendance[]
  leaveRequests          StaffLeaveRequest[]
  reportCardAssessments  ReportCardAssessment[]
  timetableSlots         TimetableSlot[]

  @@map("staff")
}

model TeachingAssignment {
  id           String   @id @default(cuid())
  staffId      String   @map("staff_id")
  classLevelId String   @map("class_level_id")
  subjectId    String   @map("subject_id")
  sessionId    String   @map("session_id")
  createdAt    DateTime @default(now()) @map("created_at")

  staff      Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  classLevel ClassLevel      @relation(fields: [classLevelId], references: [id])
  subject    Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  session    AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("teaching_assignments")
}

model FormTeacherAssignment {
  id           String   @id @default(cuid())
  staffId      String   @map("staff_id")
  classLevelId String   @map("class_level_id")
  sessionId    String   @map("session_id")
  createdAt    DateTime @default(now()) @map("created_at")

  staff      Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  classLevel ClassLevel      @relation(fields: [classLevelId], references: [id])
  session    AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([classLevelId, sessionId])
  @@map("form_teacher_assignments")
}

model Subject {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teachingAssignments TeachingAssignment[]
  resultEntries       ResultEntry[]
  cbtExams            CbtExam[]
  timetableSlots      TimetableSlot[]

  @@unique([tenantId, name])
  @@map("subjects")
}

model ResultEntry {
  id        String       @id @default(cuid())
  studentId String       @map("student_id")
  subjectId String       @map("subject_id")
  termId    String       @map("term_id")
  teacherId String       @map("teacher_id")
  scoreData Json         @map("score_data")
  grade     String? // §5A.7 — frozen at publish time, never recomputed
  comment   String?
  status    ResultStatus @default(not_started)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  teacher Staff   @relation(fields: [teacherId], references: [id])

  @@unique([studentId, subjectId, termId])
  @@map("result_entries")
}

model ClassResultReview {
  id                 String    @id @default(cuid())
  classLevelId       String    @map("class_level_id")
  termId             String    @map("term_id")
  formTeacherId      String    @map("form_teacher_id")
  overallRemarks     String?   @map("overall_remarks")
  submittedToAdminAt DateTime? @map("submitted_to_admin_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  classLevel  ClassLevel @relation(fields: [classLevelId], references: [id])
  term        Term       @relation(fields: [termId], references: [id], onDelete: Cascade)
  formTeacher Staff      @relation(fields: [formTeacherId], references: [id])

  @@unique([classLevelId, termId])
  @@map("class_result_reviews")
}

model ReportCardAssessment {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  studentId          String   @map("student_id")
  classLevelId       String   @map("class_level_id")
  termId             String   @map("term_id")
  formTeacherId      String   @map("form_teacher_id")
  affectiveRatings   Json     @map("affective_ratings")
  psychomotorRatings Json     @map("psychomotor_ratings")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classLevel  ClassLevel @relation(fields: [classLevelId], references: [id])
  term        Term       @relation(fields: [termId], references: [id], onDelete: Cascade)
  formTeacher Staff      @relation(fields: [formTeacherId], references: [id])

  @@unique([tenantId, studentId, termId])
  @@index([tenantId, classLevelId, termId])
  @@map("report_card_assessments")
}

model ResultPIN {
  id          String    @id @default(cuid())
  studentId   String    @map("student_id")
  termId      String    @map("term_id")
  code        String    @unique
  pricePaid   Decimal   @map("price_paid") @db.Decimal(10, 2)
  platformFee Decimal   @map("platform_fee") @db.Decimal(10, 2)
  schoolNet   Decimal   @map("school_net") @db.Decimal(10, 2)
  paymentRef  String    @map("payment_ref")
  status      PinStatus @default(unused)
  usesCount   Int       @default(0) @map("uses_count")
  maxUses     Int       @default(5) @map("max_uses")
  activatedAt DateTime? @map("activated_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  usages  ResultPinUsage[]
  transferVerification PinTransferVerification?
  settlementId String? @map("settlement_id")
  settlement   PinSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([studentId, termId])
  @@map("result_pins")
}

model ResultPinUsage {
  id          String   @id @default(cuid())
  resultPinId String   @map("result_pin_id")
  studentId   String   @map("student_id")
  usedAt      DateTime @default(now()) @map("used_at")

  resultPin ResultPIN @relation(fields: [resultPinId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("result_pin_usages")
}

model PinSettlement {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  grossAmount        Decimal  @map("gross_amount") @db.Decimal(10, 2)
  platformFeeAmount  Decimal  @map("platform_fee_amount") @db.Decimal(10, 2)
  schoolNetAmount    Decimal  @map("school_net_amount") @db.Decimal(10, 2)
  payoutReference    String   @map("payout_reference")
  settledBy          String   @map("settled_by")
  settledAt          DateTime @default(now()) @map("settled_at")
  createdAt          DateTime @default(now()) @map("created_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pins   ResultPIN[]

  @@unique([tenantId, payoutReference])
  @@index([tenantId, settledAt])
  @@map("pin_settlements")
}

model ImpersonationLog {
  id           String    @id @default(cuid())
  superAdminId String    @map("super_admin_id")
  tenantId     String    @map("tenant_id")
  reason       String
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")

  superAdmin SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("impersonation_logs")
}

model FeeItem {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  termId       String   @map("term_id")
  classLevelId String?  @map("class_level_id")
  name         String
  amount       Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  term        Term                   @relation(fields: [termId], references: [id], onDelete: Cascade)
  classLevel  ClassLevel?            @relation(fields: [classLevelId], references: [id])
  adjustments StudentFeeAdjustment[]

  @@map("fee_items")
}

model StudentFeeAdjustment {
  id              String            @id @default(cuid())
  studentId       String            @map("student_id")
  feeItemId       String            @map("fee_item_id")
  adjustmentType  FeeAdjustmentType @map("adjustment_type")
  amountOrPercent Decimal           @map("amount_or_percent") @db.Decimal(10, 2)
  createdAt       DateTime          @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeItem FeeItem @relation(fields: [feeItemId], references: [id], onDelete: Cascade)

  @@unique([studentId, feeItemId])
  @@map("student_fee_adjustments")
}

model FeePayment {
  id         String           @id @default(cuid())
  studentId  String           @map("student_id")
  termId     String           @map("term_id")
  amount     Decimal          @db.Decimal(10, 2)
  method     FeePaymentMethod
  paymentRef String?          @map("payment_ref")
  recordedBy String?          @map("recorded_by")
  paidAt     DateTime         @default(now()) @map("paid_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term          Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  recordedStaff Staff?  @relation(fields: [recordedBy], references: [id])

  @@map("fee_payments")
}

model TenantPaymentGateway {
  id                    String   @id @default(cuid())
  tenantId              String   @unique @map("tenant_id")
  paystackSecretCipher  String   @map("paystack_secret_cipher") @db.Text
  enabled               Boolean  @default(false)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_payment_gateways")
}

model PaymentIntent {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  reference  String   @unique
  purpose    String
  studentId  String?  @map("student_id")
  termId     String?  @map("term_id")
  amount     Decimal  @db.Decimal(10, 2)
  payerEmail String   @map("payer_email")
  status     String   @default("initializing")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, purpose, status])
  @@map("payment_intents")
}

model SiteContent {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  page      String
  content   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, page])
  @@map("site_contents")
}

model GalleryImage {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
