# Copy to .env.production on the VPS. Never commit the completed file.
NEXT_PUBLIC_ROOT_DOMAIN=eduorg.ng
ACME_EMAIL=you@eduorg.ng

# Use a long hexadecimal password (for example: openssl rand -hex 32).
# Keep this value URL-safe and use the exact same value in DATABASE_URL.
POSTGRES_DB=bms_production
POSTGRES_USER=bms_app
POSTGRES_PASSWORD=replace_with_64_hex_characters
DATABASE_URL=postgresql://bms_app:replace_with_64_hex_characters@database:5432/bms_production?sslmode=disable

# Generate a separate long random value (for example: openssl rand -hex 32).
SESSION_SECRET=replace_with_a_long_random_secret

# Required before enabling production email delivery.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Required before enabling uploads. Use a real S3-compatible object-storage account.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_URL=

# Fill these only when enabling the corresponding payment provider.
PAYSTACK_SECRET_KEY=
# Generate with: openssl rand -base64 32. Never rotate without re-encrypting stored tenant payment credentials.
TENANT_SECRET_ENCRYPTION_KEY=
# Optional Meta WhatsApp Cloud API. Configure approved result template with four body placeholders in this order: parent name, student name, term, portal URL.
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_RESULT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
FLUTTERWAVE_SECRET_HASH=
