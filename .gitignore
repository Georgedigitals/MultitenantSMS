# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-module-control-check/
/out/

# production
/build

# Local/demo database files and uploaded test assets must never be committed.
/prisma/pgdata*/
/public/uploads/
/prisma-engines/
/scratch/
scratch_*.ts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example
!.env.seed.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
