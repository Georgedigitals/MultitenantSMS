# Example Environment Configuration
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5439/template1?sslmode=disable"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
NODE_ENV="development"
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"
SUPER_ADMIN_EMAIL="admin@yourdomain.com"
SUPER_ADMIN_PASSWORD="replace-with-a-unique-strong-password"

# Universal Platform SMTP Configuration (Nodemailer)
# Connect to cPanel webmail, Zoho, Google Workspace, AWS SES, or any mail server
SMTP_HOST="mail.yourdomain.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="notifications@yourdomain.com"
SMTP_PASS="your_secure_smtp_password"
SMTP_FROM="EduSaaS OS <notifications@yourdomain.com>"

# S3-compatible public asset storage (required for production uploads)
OBJECT_STORAGE_ENDPOINT="https://s3.example-provider.com"
OBJECT_STORAGE_BUCKET="bms-assets"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_ACCESS_KEY_ID="your_access_key_id"
OBJECT_STORAGE_SECRET_ACCESS_KEY="your_secret_access_key"
OBJECT_STORAGE_PUBLIC_URL="https://assets.example.com/bms-assets"

# Payment provider secrets (configure only providers you enable)
PAYSTACK_SECRET_KEY=""
# Generate a unique key with: openssl rand -base64 32. Back it up securely; losing it makes tenant Paystack keys unreadable.
TENANT_SECRET_ENCRYPTION_KEY=""
# Optional Meta WhatsApp Cloud API. The result template must be approved with 4 body placeholders:
# parent name, student name, term, portal URL (in that order).
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_API_VERSION=""
WHATSAPP_RESULT_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
FLUTTERWAVE_SECRET_HASH=""
